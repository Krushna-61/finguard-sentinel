# ============================================
# FINGUARD BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# HUGGING FACE API (Optional - for cloud models)
# ============================================
HF_API_TOKEN=your_huggingface_token_here
HF_TIMEOUT=10
HF_MAX_RETRIES=2
HF_FAILURE_THRESHOLD=3

# ============================================
# MODEL CONFIGURATION
# ============================================
# Set to 'true' to use local models, 'false' for HuggingFace API
USE_LOCAL_MODELS=true

# Device for model inference: 'cuda' for GPU, 'cpu' for CPU
MODEL_DEVICE=cpu

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql+psycopg2://username:password@host:port/database
DATABASE_URL=postgresql+psycopg2://finguard:your_password@localhost:5432/finguard_db

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# API Key for backend authentication (change in production!)
FINGUARD_API_KEY=your-secure-api-key-here

# JWT Configuration
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ============================================
# ALERTING
# ============================================
# Slack webhook URL for critical alerts (optional)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# RATE LIMITING
# ============================================
# Maximum requests per minute per user
RATE_LIMIT_PER_MINUTE=100

# ============================================
# RUNTIME CONFIGURATION
# ============================================
# Environment: development, staging, production
ENV=development

# Enable debug mode (set to false in production)
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
